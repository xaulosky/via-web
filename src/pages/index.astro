---
import Base from '../layouts/Base.astro';
const title = 'Vía Los Ángeles — Home';
---

<Base title={title}>
  <div class="wrap">
    <!-- TOP LEADERBOARD AD -->
    <div class="ad leader">
      <span class="lbl">Espacio destacado</span>
      <span class="sz">Banner cabecera · 970 × 120</span>
    </div>

    <!-- HERO -->
    <section class="hero">
      <div>
        <div class="cover">
          <div class="ph">
            <img src="https://revistavialosangeles.cl/wp-content/uploads/2026/05/DSC09735-DxO_DeepPRIME-3-editada-e1778015451518-768x501.jpg" alt="Portada">
          </div>
          <div class="scrim"></div>
          <div class="iss">Nº 21 · MAYO</div>
          <div class="top">
            <div class="cmark serif">Ví<em>a</em></div>
            <div class="csub">Los Ángeles · Identidad Local</div>
          </div>
          <div class="lines">
            <div class="cl serif">Lucca <em>Bakery</em></div>
            <div class="cl serif">Moda Otoño-Invierno · Vía Explora: Huerquehue · Celebrando a mamá</div>
          </div>
        </div>
        <div class="cover-note">↑ Portada del mes — reemplazable por el escaneo real de cada edición</div>
      </div>

      <div class="feature">
        <span class="kicker">En portada · Edición de Mayo</span>
        <h1 class="serif">Lucca Bakery</h1>
        <p class="dek serif">Un emprendimiento familiar que conquista paladares</p>
        <p class="lede">Detrás del mesón, una historia de oficio y herencia. Conversamos con la familia que transformó una receta de casa en el rincón dulce favorito de Los Ángeles, donde la masa madre y la paciencia mandan.</p>
        <div class="actions">
          <a class="btn primary" href="/ediciones">📖 Leer edición digital</a>
          <a class="btn ghost" href="/ediciones">Ediciones anteriores</a>
        </div>

        <div class="also">
          <div class="lbl">También en esta edición</div>
          <div class="also-grid">
            <a class="also-it" href="/articulo">
              <div class="th"><img src="https://revistavialosangeles.cl/wp-content/uploads/2026/05/Agrupacion-Cultural-Perfiles-Siluetas.jpg" alt=""></div>
              <div><div class="k">En Escena</div><h4 class="serif">El teatro vive en Los Ángeles</h4></div>
            </a>
            <a class="also-it" href="#">
              <div class="th"><img src="https://revistavialosangeles.cl/wp-content/uploads/2026/05/MODA-1-e1778101333238.jpg" alt=""></div>
              <div><div class="k">Moda</div><h4 class="serif">Elegancia relajada de invierno</h4></div>
            </a>
            <a class="also-it" href="#">
              <div class="th"><img src="https://revistavialosangeles.cl/wp-content/uploads/2026/05/recorriendo-editada-3-768x817.jpg" alt=""></div>
              <div><div class="k">Historia</div><h4 class="serif">U. de Concepción: 64 años</h4></div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- EN ESTA EDICIÓN -->
    <section class="edition">
      <div class="sec-head">
        <h2 class="serif">En esta edición</h2>
        <span class="rule"></span>
        <a class="more" href="/seccion">Ver todas las secciones →</a>
      </div>

        <div class="mosaic">
          <a class="art feat" href="/articulo">
            <div class="img"><img src="https://revistavialosangeles.cl/wp-content/uploads/2026/05/0743A034-B030-42F0-9E86-334C1B1F874C-4-768x1018.jpg" alt=""></div>
            <div class="meta">
              <div class="k">Vía Explora</div>
              <h3 class="serif">Parque Nacional Huerquehue</h3>
              <p>Un paisaje inolvidable en el sur de Chile: araucarias, lagunas de altura y senderos para perderse el fin de semana.</p>
            </div>
          </a>

          <a class="art tall" href="#">
            <div class="img"><img src="https://revistavialosangeles.cl/wp-content/uploads/2026/05/Grupal-1-e1777984252755-768x622.jpg" alt=""></div>
            <div class="meta"><div class="k">Sociedad</div><h3 class="serif">Celebrando a mamá</h3></div>
          </a>

          <a class="art" href="#">
            <div class="img"><img src="https://revistavialosangeles.cl/wp-content/uploads/2026/05/ODONTO-MAYO-768x533.jpg" alt=""></div>
            <div class="meta"><div class="k">Salud</div><h3 class="serif">¿Las carillas son para todos?</h3></div>
          </a>

          <a class="art" href="#">
            <div class="img"><img src="https://revistavialosangeles.cl/wp-content/uploads/2026/05/GASTRO-MAYO-final-2-768x537.jpg" alt=""></div>
            <div class="meta"><div class="k">Gastronomía</div><h3 class="serif">Crema de repollo morado</h3></div>
          </a>

          <div class="ad tile box">
            <span class="lbl">Espacio publicitario</span>
            <span class="sz">Recuadro · 600 × 200</span>
          </div>

          <a class="art" href="#">
            <div class="img"><img src="https://revistavialosangeles.cl/wp-content/uploads/2026/05/MODA-1-e1778101333238.jpg" alt=""></div>
            <div class="meta"><div class="k">Moda</div><h3 class="serif">Otoño-Invierno 2026</h3></div>
          </a>

          <a class="art" href="#">
            <div class="img"><img src="https://revistavialosangeles.cl/wp-content/uploads/2026/05/Francine-Ellena-Carolina-Sobarzo-y-Carolina-Vivallo-1-e1778116548443-768x550.jpg" alt=""></div>
            <div class="meta"><div class="k">Sociales</div><h3 class="serif">Lanzamiento en Haras Santa Amelia</h3></div>
          </a>

          <a class="art wide" href="#">
            <div class="img"><img src="https://revistavialosangeles.cl/wp-content/uploads/2026/05/Agrupacion-Cultural-Perfiles-Siluetas.jpg" alt=""></div>
            <div class="meta"><div class="k">En Escena</div><h3 class="serif">El teatro vive en Los Ángeles</h3></div>
          </a>
        </div>

        <!-- MID LEADERBOARD -->
        <div class="ad leader mid">
          <span class="lbl">Espacio entre secciones</span>
          <span class="sz">Banner · 970 × 90</span>
        </div>
      </section>
    </div>

    <!-- SPONSORS -->
    <section class="sponsors">
      <div class="lbl">Quienes hacen posible esta edición</div>
      <div class="row">
        <div class="ad box"><span class="sz">Auspiciador</span></div>
        <div class="ad box"><span class="sz">Auspiciador</span></div>
        <div class="ad box"><span class="sz">Auspiciador</span></div>
        <div class="ad box"><span class="sz">Auspiciador</span></div>
      </div>
    </section>

</div>
</Base>
